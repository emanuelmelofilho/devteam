# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kanban
DB_USERNAME=kanban
DB_PASSWORD=kanban

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# WhatsApp API
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# Initial administrator (required only when running AdminSeeder)
ADMIN_NAME="Devteam Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Application
APP_URL=http://localhost

# Host workers (agents/runtime/host_worker.mjs) — opcional
# O provedor (Codex ou Claude) e as chaves da API são escolhidos em Configurações.
# Nome do modelo usado pelo Codex CLI, só para rotular as métricas de custo/tokens
# em agent_executions; deixe em branco se não quiser rastrear isso.
CODEX_MODEL=
# Caminho do binário do Claude Code (padrão: `claude` no PATH) e modelo do provedor Claude.
# Em branco, o worker usa claude-sonnet-5. O padrão do próprio Claude Code é o Opus 5, cerca de
# 2,5 vezes mais caro. Exemplos: claude-opus-5, claude-sonnet-5, claude-haiku-4-5.
CLAUDE_BIN=
CLAUDE_MODEL=
# Nível de esforço do Claude Code (low, medium, high, xhigh, max); em branco usa o padrão dele.
# Menos esforço gasta menos tokens de saída, que custam 5x os de entrada.
CLAUDE_EFFORT=
# Teto de gasto por execução, em dólares (padrão 2). A execução é interrompida ao atingi-lo.
CLAUDE_MAX_BUDGET_USD=
